---
/**
 * FlexiDash Local Development & Testing Hub (/)
 */
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FlexiDash — Development & Testing Hub</title>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 40px 20px;
        background: #f7fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #2d3748;
      }
      .container {
        max-width: 840px;
        margin: 0 auto;
      }
      .header {
        text-align: center;
        margin-bottom: 36px;
      }
      .badge {
        display: inline-block;
        background: #ebf8ff;
        color: #2b6cb0;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        margin-bottom: 12px;
        letter-spacing: 0.05em;
      }
      h1 {
        font-size: 32px;
        margin: 0 0 10px 0;
        color: #1a202c;
      }
      p.subtitle {
        font-size: 16px;
        color: #718096;
        margin: 0;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
      }
      .card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .card h2 {
        font-size: 20px;
        margin: 0 0 8px 0;
        color: #2b6cb0;
      }
      .card p {
        font-size: 14px;
        color: #4a5568;
        line-height: 1.5;
        margin: 0 0 20px 0;
      }
      .btn {
        display: inline-block;
        text-align: center;
        text-decoration: none;
        padding: 12px 20px;
        background: #3182ce;
        color: #ffffff;
        border-radius: 8px;
        font-weight: 600;
        font-size: 15px;
        transition: background 0.15s ease;
      }
      .btn:hover {
        background: #2b6cb0;
      }
      .btn-secondary {
        background: #2d3748;
      }
      .btn-secondary:hover {
        background: #1a202c;
      }
      .info-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px 24px;
      }
      .info-box h3 {
        margin: 0 0 12px 0;
        font-size: 15px;
        color: #2d3748;
      }
      .creds-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        font-size: 13px;
      }
      .cred-item {
        background: #edf2f7;
        padding: 10px 14px;
        border-radius: 6px;
      }
      .cred-role {
        font-weight: 700;
        color: #2b6cb0;
        margin-bottom: 4px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <span class="badge">DEVELOPMENT & TESTING HUB</span>
        <h1>FlexiDash Browser Testing</h1>
        <p class="subtitle">Personalized Member Portals, RBAC Engine & Layout Customization</p>
      </div>

      <div class="grid">
        <div class="card">
          <div>
            <h2>Site Member Portal</h2>
            <p>Member-facing dashboard interface where authenticated site members view their permitted widgets, custom layout, and personalized cards.</p>
          </div>
          <a class="btn" href="/portal">Open Member Portal (/portal) &rarr;</a>
        </div>

        <div class="card">
          <div>
            <h2>Dashboard Extension (Admin)</h2>
            <p>Wix Dashboard app extension with 7 management tabs: Overview, Authentication, RBAC Role Management, Member Roster, Page Access Rules, Drag & Drop Layout Editor, and Audit Logs.</p>
          </div>
          <a class="btn btn-secondary" href="/dashboard">Open Dashboard Extension (/dashboard) &rarr;</a>
        </div>
      </div>

      <div class="info-box">
        <h3>Pre-Configured Demo Accounts for Testing</h3>
        <div class="creds-grid">
          <div class="cred-item">
            <div class="cred-role">Portal Administrator</div>
            <div>Email: <code>admin@flexidash.local</code></div>
            <div>Password: <code>AdminPassword123!</code></div>
          </div>
          <div class="cred-item">
            <div class="cred-role">Standard Member</div>
            <div>Email: <code>member@flexidash.local</code></div>
            <div>Password: <code>MemberPassword123!</code></div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

